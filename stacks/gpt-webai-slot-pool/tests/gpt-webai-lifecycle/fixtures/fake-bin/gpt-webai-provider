next_sequence() {
  local name="$1" default_value="$2"
  local seq="$fake_root/$name"
  local tmp="$fake_root/$name.next.$$"
  local lock="$fake_root/$name.lock"
  local line="" current first=1
  local waited=0

  mkdir -p "$fake_root"
  while ! mkdir "$lock" 2>/dev/null; do
    waited=$((waited + 1))
    if [[ "$waited" -gt 500 ]]; then
      printf 'timed out waiting for fake sequence lock: %s\n' "$name" >&2
      exit 76
    fi
    sleep 0.01
  done

  if [[ -f "$seq" ]]; then
    : > "$tmp"
    while IFS= read -r current || [[ -n "$current" ]]; do
      if [[ "$first" -eq 1 ]]; then
        line="$current"
        first=0
      else
        printf '%s\n' "$current" >> "$tmp"
      fi
    done < "$seq"
    mv -f "$tmp" "$seq"
  fi
  rmdir "$lock" 2>/dev/null || true

  printf '%s' "${line:-$default_value}"
}

