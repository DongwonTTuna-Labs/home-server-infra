    state_root, "artifacts", request_key
)


def artifact_write_path(host_rel_path):
    if not artifact_container_root:
        return os.path.join(state_root, host_rel_path)
    parts = host_rel_path.split("/")
    request_key = os.path.basename(artifact_container_root.rstrip("/"))
    if len(parts) < 3 or parts[:2] != ["artifacts", request_key]:
        raise SystemExit("fake artifact path is outside the mounted request root")
    return os.path.join(artifact_container_root, *parts[2:])

