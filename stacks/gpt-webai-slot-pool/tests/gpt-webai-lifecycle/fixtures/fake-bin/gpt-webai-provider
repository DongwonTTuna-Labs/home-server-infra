      event="$(next_sequence resume-sequence resumed)"
      ;;
    prune)
      printf '%s\n' "${args[*]}" >> "$fake_root/prune-calls"
      if [[ -f "$fake_root/prune-fail" ]]; then
        printf 'fake sessions prune must not be called\n' >&2
        exit 71
      fi
      printf '{"fake":true,"pruned":0}\n'
      return 0
      ;;
    *)
      printf 'unsupported fake sessions action: %s\n' "$action" >&2
      exit 2
      ;;
  esac

  case "$event" in
    malformed)
      printf 'not-json\n'
      ;;
    malformed-patch)
      printf 'PATCH_READY\n\n'
      printf 'diff --git a/context.txt b/context.txt\n'
      printf -- '--- a/context.txt\n'
      printf '+++ b/context.txt\n'
      printf '@@ -1 +1 @@\n'
      printf -- '-old\n'
      printf -- '+new\n'
      ;;
    hard)
      printf 'fake sessions %s hard failure for %s\n' "$action" "$sid" >&2
      exit 70
      ;;
    target-metadata)
      printf '{"fake":true,"status":"show","session":{"sessionId":"%s","targetId":"target-%s","tabId":"target-%s","conversationUrl":"https://chatgpt.com/c/%s"}}\n' "$sid" "$sid" "$sid" "$sid"
      ;;
    final-visible)
      printf '{"fake":true,"sessionId":"%s","status":"done","answerText":"final visible answer from resumed ChatGPT UI","targetId":"target-%s","conversationUrl":"https://chatgpt.com/c/%s","activeTurn":false,"assistantCount":1,"userCount":1,"assistantTurn":{"turnIndex":0,"domId":"assistant-final","textSha256":"sha-final-visible"},"turnEvidence":{"activeTurn":false,"userCount":1,"assistantCount":1,"latestAssistantSha256":"sha-final-visible"}}\n' "$sid" "$sid" "$sid"
      ;;
    final-visible-artifact)
      printf '{"fake":true,"sessionId":"%s","status":"done","answerText":"final visible answer with recovered artifact","targetId":"target-%s","conversationUrl":"https://chatgpt.com/c/%s","activeTurn":false,"assistantCount":1,"userCount":1,"artifacts":[{"download":{"visibleFilename":"recovered.tar.gz","savedPath":"/tmp/recovered.tar.gz","size":12,"sha256":"sha-recovered"}}],"assistantTurn":{"turnIndex":0,"domId":"assistant-final","textSha256":"sha-final-visible-artifact"},"turnEvidence":{"activeTurn":false,"userCount":1,"assistantCount":1,"latestAssistantSha256":"sha-final-visible-artifact"}}\n' "$sid" "$sid" "$sid"
      ;;
    final-visible-wrong-url)
      printf '{"fake":true,"sessionId":"%s","status":"done","answerText":"final answer from another ChatGPT conversation","targetId":"target-other-session","conversationUrl":"https://chatgpt.com/c/other-session","activeTurn":false,"assistantCount":1,"userCount":1,"assistantTurn":{"turnIndex":0,"domId":"assistant-final","textSha256":"sha-final-visible-wrong"},"turnEvidence":{"activeTurn":false,"userCount":1,"assistantCount":1,"latestAssistantSha256":"sha-final-visible-wrong"}}\n' "$sid"
      ;;
    artifact-controls-absent)
      printf '{"fake":true,"sessionId":"%s","status":"artifact.controls_absent","reason":"artifact.controls_absent","answerText":"ARTIFACT_DONE but no controls","targetId":"target-%s","conversationUrl":"https://chatgpt.com/c/%s","artifacts":[]}\n' "$sid" "$sid" "$sid"
      ;;
    pro-required)
      printf '{"fake":true,"sessionId":"%s","status":"subscription_required","reason":"auth.needs_pro","message":"upgrade required","targetId":"target-%s","conversationUrl":"https://chatgpt.com/c/%s"}\n' "$sid" "$sid" "$sid"
      ;;
    *)
      if [[ -f "$fake_root/sessions-success-stderr" ]]; then
        printf '[poll] 0s - stabilizing...\n' >&2
      fi
      printf '{"fake":true,"sessionId":"%s","status":"%s"}\n' "$sid" "$event"
      ;;
  esac
}

fake_start() {
  mkdir -p "$fake_root"
  if [[ -f "$fake_root/start-fail" ]]; then
    printf 'fake start failed\n' >&2
    exit 70
  fi
  printf '%s\n' "${args[*]}" >> "$fake_root/start-calls"
  printf '{"fake":true,"started":true}\n'
}

fake_tab_cleanup() {
  mkdir -p "$fake_root"
  printf '%s\n' "${args[*]}" >> "$fake_root/tab-cleanup-calls"
  if [[ -f "$fake_root/tab-cleanup.json" ]]; then
    cat "$fake_root/tab-cleanup.json"
  else
    printf '{"fake":true,"candidates":[],"untracked":[]}\n'
  fi
}

case "${args[0]:-}" in
  status)
    next_status
    ;;
  send)
    fake_send
    ;;
  poll)
    fake_poll
    ;;
  sessions)
    fake_sessions
    ;;
  stop)
    mkdir -p "$fake_root"
    printf '%s\n' "${args[*]}" >> "$fake_root/stop-calls"
    printf 'fake provider stop must not be called\n' >&2
    exit 71
    ;;
  doctor)
    printf 'fake doctor must not be called\n' >&2
    exit 71
    ;;
  start)
    fake_start
    ;;
  tab-cleanup)
    fake_tab_cleanup
    ;;
  *)
    printf '{"fake":true,"ok":true}\n'
    ;;
esac
