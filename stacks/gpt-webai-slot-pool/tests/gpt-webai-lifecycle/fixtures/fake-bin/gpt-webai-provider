#!/usr/bin/env bash
set -euo pipefail

args=("$@")
# The Docker full gate bind-mounts this executable over the container's
# `node` binary.  Preserve the production docker-exec argv shape while
# stripping only the one canonical provider entrypoint that Node would have
# consumed before forwarding CLI arguments.
if [[ "${args[0]:-}" == provider/chatgpt-playwright/cli.mjs ]]; then
  args=("${args[@]:1}")
fi
log="${GPT_WEBAI_FAKE_PROVIDER_LOG:-}"
fake_root="${GPT_WEBAI_FAKE_PROVIDER_ROOT:-${GPT_WEBAI_TEST_ROOT:-}/fake-provider}"

fake_r13() {
  exec python3 - "${args[@]}" <<'PY'
import base64
import fcntl
import hashlib
import json
import os
import sys


def canonical(value):
    return json.dumps(
        value, ensure_ascii=False, separators=(",", ":"), sort_keys=True
    ).encode("utf-8") + b"\n"


def sha(value):
    return hashlib.sha256(value).hexdigest()


def h256(value):
    return "sha256:" + sha(value)


def derived(prefix, value):
    return prefix + "_" + sha(canonical(value))


def write_new(path, data):
    parent = os.path.dirname(path)
    os.makedirs(parent, mode=0o700, exist_ok=True)
    os.chmod(parent, 0o700)
    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(descriptor, "wb") as stream:
        stream.write(data)
        stream.flush()
        os.fsync(stream.fileno())


def evidence(path):
    data = ("fixture:" + path).encode("utf-8")
    return {
        "mediaType": "application/json",
        "path": path,
        "sha256": h256(data),
        "sizeBytes": len(data),
    }


def control(label, turn_id=None):
    label_hash = h256((label + ":label").encode("utf-8"))
    dom_hash = h256((label + ":dom").encode("utf-8"))
    box_hash = h256((label + ":box").encode("utf-8"))
    value = {
        "boundingBoxHash": box_hash,
        "controlId": derived(
            "control", ["button", "button", "", label_hash, dom_hash, box_hash]
        ),
        "disabled": False,
        "domPathHash": dom_hash,
        "labelHash": label_hash,
        "role": "button",
        "testIdHash": None,
        "visible": True,
    }
    if turn_id is not None:
        value = {
            "boundingBoxHash": box_hash,
            "controlId": value["controlId"],
            "currentTurnId": turn_id,
            "disabled": False,
            "domPathHash": dom_hash,
            "role": "button",
            "visible": True,
            "visibleTextHash": label_hash,
        }
    return value


def root_id(label, role):
    label_hash = h256((label + ":label").encode("utf-8"))
    dom_hash = h256((label + ":dom").encode("utf-8"))
    box_hash = h256((label + ":box").encode("utf-8"))
    return derived("root", ["main", role, "", label_hash, dom_hash, box_hash])


def receipt(operation, identity, session_id, payload):
    value = {
        "createdAtMs": 1000,
        "operation": operation,
        "operationId": identity["operationId"],
        "payload": payload,
        "receiptId": "",
        "requestId": identity["requestId"],
        "runId": identity["runId"],
        "schema": "pr72.receipt.r13.v1",
        "sessionId": session_id,
    }
    value["receiptId"] = "receipt_" + sha(canonical(value))
    return value


def load_script_entry(script_path):
    if not script_path:
        return {}, None
    with open(script_path, "rb") as stream:
        script_bytes = stream.read()
    script = json.loads(script_bytes)
    if not isinstance(script, list):
        raise SystemExit("fake script must be an array")
    lock_path = script_path + ".counter.lock"
    descriptor = os.open(lock_path, os.O_RDWR | os.O_CREAT, 0o600)
    with os.fdopen(descriptor, "r+") as lock_stream:
        fcntl.flock(lock_stream.fileno(), fcntl.LOCK_EX)
        counter_path = script_path + ".counter"
        try:
            with open(counter_path, "r", encoding="ascii") as counter_stream:
                index = int(counter_stream.read())
        except FileNotFoundError:
            index = 0
        if index >= len(script):
            raise SystemExit(3)
        temporary = counter_path + ".next"
        descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(descriptor, "w", encoding="ascii") as counter_stream:
            counter_stream.write(str(index + 1))
            counter_stream.flush()
            os.fsync(counter_stream.fileno())
        os.replace(temporary, counter_path)
        entry = script[index]
    if not isinstance(entry, dict) or set(entry) != {
        "expectOperation", "frame", "malformedBytesB64"
    }:
        raise SystemExit("invalid fake script entry")
    malformed = entry["malformedBytesB64"]
    frame_path = entry["frame"]
    if malformed is not None:
        if frame_path is not None or not isinstance(malformed, str):
            raise SystemExit("invalid malformed fake frame")
        return entry, base64.b64decode(malformed, validate=True)
    frame = {}
    if frame_path is not None:
        if not isinstance(frame_path, str) or not os.path.isabs(frame_path):
            raise SystemExit("fake frame path must be absolute")
        with open(frame_path, "rb") as stream:
            frame = json.load(stream)
        if not isinstance(frame, dict):
            raise SystemExit("fake frame must be an object")
    entry = dict(entry)
    entry["frameData"] = frame
    return entry, None


def expected_operation_matches(expected, actual):
    if expected == actual:
        return True
    aliases = {
        "send.pre_click": {"send-click", "send-reconcile"},
        "send.post_click": {"send-click"},
        "send.reconciled_turn_start": {"send-reconcile"},
    }
    return actual in aliases.get(expected, set())


